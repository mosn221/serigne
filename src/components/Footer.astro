---
const pathname = Astro.url.pathname;
const isFrench = pathname === '/fr' || pathname.startsWith('/fr/');
const sportsHref = isFrench ? '/fr/sports/' : '/sports/';
const nutritionHref = isFrench ? '/fr/nutrition/' : '/nutrition/';
const openHref = isFrench ? '/fr/open/' : '/open/';
---

<footer class="m221-footer">
  <div class="m221-container m221-footer-inner">
    <div>
      <strong>M221Tech</strong>
      <div>{isFrench ? 'Des produits construits à partir de données locales.' : 'Products built from local data.'}</div>
      <small>© {new Date().getFullYear()} M221Tech</small>
    </div>

    <nav class="m221-footer-links" aria-label={isFrench ? 'Liens de pied de page' : 'Footer links'}>
      <a href={sportsHref}>Sports</a>
      <a href={nutritionHref}>Nutrition</a>
      <a href={openHref}>Open</a>
      <a href="https://www.linkedin.com/company/m221tech" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </nav>
  </div>
</footer>
