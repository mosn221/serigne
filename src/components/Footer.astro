---
const pathname = Astro.url.pathname;
const isFrench = pathname === '/fr' || pathname.startsWith('/fr/');
const homeHref = isFrench ? '/fr/' : '/';
const projectsHref = `${homeHref}#projects`;
const whyHref = `${homeHref}#why`;
const labHref = `${homeHref}#lab`;
const openHref = `${homeHref}#open`;
const contactHref = `${homeHref}#contact`;

const labels = isFrench
  ? { projects: 'Projets', why: 'Why', lab: 'Lab', open: 'Open', contact: 'Contact' }
  : { projects: 'Projects', why: 'Why', lab: 'Lab', open: 'Open', contact: 'Contact' };
---

<footer class="m221-footer">
  <div class="m221-container m221-footer-inner">
    <div>
      <strong>M221Tech</strong>
      <div>{isFrench ? 'Données locales. Produits utiles.' : 'Local data. Useful products.'}</div>
      <small>© {new Date().getFullYear()} M221Tech</small>
    </div>

    <nav class="m221-footer-links" aria-label={isFrench ? 'Liens de pied de page' : 'Footer links'}>
      <a href={projectsHref}>{labels.projects}</a>
      <a href={whyHref}>{labels.why}</a>
      <a href={labHref}>{labels.lab}</a>
      <a href={openHref}>{labels.open}</a>
      <a href={contactHref}>{labels.contact}</a>
      <a href="https://www.linkedin.com/company/m221tech" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </nav>
  </div>
</footer>
