---
// Shared portfolio-neutral footer. Keep project names out of this component so the
// global navigation does not need to change whenever the portfolio evolves.
const pathname = Astro.url.pathname;
const isFrench = pathname === '/fr' || pathname.startsWith('/fr/');
const homeHref = isFrench ? '/fr/' : '/';
const projectsHref = `${homeHref}#projects`;
const openHref = `${homeHref}#open`;
const contactHref = `${homeHref}#contact`;

const labels = isFrench
  ? { home: 'Accueil', projects: 'Projets', open: 'Open', contact: 'Contact' }
  : { home: 'Home', projects: 'Projects', open: 'Open', contact: 'Contact' };
---

<!-- The full horizontal lockup is intentional here: the footer is a brand-forward
     surface, unlike favicon/PWA contexts that use the standalone M mark. -->
<footer class="m221-footer">
  <div class="m221-container m221-footer-shell">
    <div class="m221-footer-main">
      <div class="m221-footer-brand-block">
        <a class="m221-footer-brand" href={homeHref} aria-label={isFrench ? 'Accueil M221Tech' : 'M221Tech home'}>
          <img
            src="/assets/img/m221tech-wordmark.svg"
            alt=""
            width="342"
            height="64"
            loading="lazy"
            decoding="async"
          />
        </a>
      </div>

      <nav class="m221-footer-links" aria-label={isFrench ? 'Liens de pied de page' : 'Footer links'}>
        <a href={homeHref}>{labels.home}</a>
        <a href={projectsHref}>{labels.projects}</a>
        <a href={openHref}>{labels.open}</a>
        <a href={contactHref}>{labels.contact}</a>
        <a
          class="m221-footer-linkedin"
          href="https://www.linkedin.com/company/m221tech"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={isFrench ? 'M221Tech sur LinkedIn, nouvel onglet' : 'M221Tech on LinkedIn, opens in a new tab'}
        >LinkedIn <span aria-hidden="true">↗</span></a>
      </nav>
    </div>

    <div class="m221-footer-meta">
      <span>© {new Date().getFullYear()} M221Tech</span>
      <span>{isFrench ? 'Des données aux usages.' : 'Data, shaped for use.'}</span>
    </div>
  </div>
</footer>
