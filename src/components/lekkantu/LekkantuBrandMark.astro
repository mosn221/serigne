---
interface Props {
  size?: number;
  className?: string;
  decorative?: boolean;
  alt?: string;
}

const {
  size = 86,
  className = '',
  decorative = true,
  alt = 'Lekkantu'
} = Astro.props;
---

<img
  class={className}
  src="/assets/lekkantu/mark-master.png"
  width={size}
  height={size}
  alt={decorative ? '' : alt}
  aria-hidden={decorative ? 'true' : undefined}
  loading="eager"
  decoding="async"
/>
