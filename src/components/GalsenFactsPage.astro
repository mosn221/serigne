---

<div class="m221-facts-page">
  <section class="m221-facts-hero">
    <div class="m221-container m221-facts-hero-inner">
      <a class="m221-facts-breadcrumb" href={isFrench ? '/fr/#projects' : '/#projects'}>{copy.breadcrumb}</a>
      <span class="m221-facts-kicker">{copy.kicker}</span>
      <h1>Galsen Facts</h1>
      <p class="m221-facts-lead"><strong>{copy.heroTitle}</strong><br />{copy.heroLead}</p>
      <div class="m221-facts-actions">
        <a class="is-primary" href="#themes">{copy.explore}</a>
        <a class="is-secondary" href="#formats">{copy.formatsCta}</a>
      </div>
    </div>
  </section>

  <div class="m221-facts-local-wrap">
    <nav class="m221-container m221-facts-local-nav" aria-label={isFrench ? 'Navigation Galsen Facts' : 'Galsen Facts navigation'} data-facts-nav>
      <a href="#themes" data-facts-link="themes"><span>01</span>{copy.nav[0]}</a>
      <a href="#formats" data-facts-link="formats"><span>02</span>{copy.nav[1]}</a>
      <a href="#explorations" data-facts-link="explorations"><span>03</span>{copy.nav[2]}</a>
      <a href="#sources" data-facts-link="sources"><span>04</span>{copy.nav[3]}</a>
    </nav>
  </div>

  <section class="m221-facts-chapter" id="themes" data-facts-section>
    <div class="m221-container">
      <header class="m221-facts-chapter-head">
        <div class="m221-facts-index">{copy.topicsIndex}</div>
        <h2>{copy.topicsTitle}</h2>
        <p>{copy.topicsIntro}</p>
      </header>

      <div class="m221-facts-topic-grid">
        {copy.topics.map((topic) => (
          <article class="m221-facts-topic" data-topic={topic.key}>
            <span class="m221-facts-topic-no">{topic.no}</span>
            <div>
              <h3>{topic.title}</h3>
              <p>{topic.body}</p>
            </div>
            <div class="m221-facts-topic-note">
              <strong>{topic.noteLabel}</strong>
              {topic.note}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="m221-facts-chapter is-alt" id="formats" data-facts-section>
    <div class="m221-container">
      <header class="m221-facts-chapter-head">
        <div class="m221-facts-index">{copy.formatsIndex}</div>
        <h2>{copy.formatsTitle}</h2>
        <p>{copy.formatsIntro}</p>
      </header>

      <div class="m221-facts-format-rail">
        {copy.formats.map((format) => (
          <article class="m221-facts-format">
            <span class="m221-facts-format-no">{format.no}</span>
            <h3>{format.title}</h3>
            <p>{format.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="m221-facts-chapter" id="explorations" data-facts-section>
    <div class="m221-container">
      <header class="m221-facts-chapter-head">
        <div class="m221-facts-index">{copy.explorationsIndex}</div>
        <h2>{copy.explorationsTitle}</h2>
        <p>{copy.explorationsIntro}</p>
      </header>

      <article class="m221-facts-empty">
        <span class="m221-facts-status">{copy.emptyStatus}</span>
        <div>
          <h3>{copy.emptyTitle}</h3>
          <p>{copy.emptyBody}</p>
        </div>
        <span class="m221-facts-empty-meta">{copy.emptyMeta}</span>
      </article>
    </div>
  </section>

  <section class="m221-facts-chapter is-alt" id="sources" data-facts-section>
    <div class="m221-container">
      <header class="m221-facts-chapter-head">
        <div class="m221-facts-index">{copy.sourcesIndex}</div>
        <h2>{copy.sourcesTitle}</h2>
        <p>{copy.sourcesIntro}</p>
      </header>

      <div class="m221-facts-method">
        <div class="m221-facts-source-steps" aria-label={isFrench ? 'Méthode Galsen Facts' : 'Galsen Facts method'}>
          {copy.method.map((step, index) => (
            <div class="m221-facts-source-step">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{step}</strong>
            </div>
          ))}
        </div>

        <aside class="m221-facts-source-note">
          <span class="m221-facts-eyebrow">{copy.sourceEyebrow}</span>
          <h3>{copy.sourceTitle}</h3>
          <p>{copy.sourceBody1}</p>
          <p>{copy.sourceBody2}</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="m221-facts-contact">
    <div class="m221-container m221-facts-contact-inner">
      <div class="m221-facts-index">{copy.contactIndex}</div>
      <div>
        <h2>{copy.contactTitle}</h2>
        <p>{copy.contactBody}</p>
      </div>
      <a href={`mailto:m221tech@gmail.com?subject=${encodeURIComponent(copy.contactSubject)}`}>m221tech@gmail.com →</a>
    </div>
  </section>
</div>

<script>
  const header = document.querySelector('.m221-header');
  const localWrap = document.querySelector('.m221-facts-local-wrap');
  const links = Array.from(document.querySelectorAll('[data-facts-link]'));
  const sections = links
    .map((link) => document.getElementById(link.dataset.factsLink || ''))
    .filter(Boolean);

  let activeId = '';
  let targetId = null;
  let ticking = false;

  const offset = () => (header?.offsetHeight || 0) + (localWrap?.offsetHeight || 0) + 1;

  const setActive = (id) => {
    if (!id || activeId === id) return;
    activeId = id;
    links.forEach((link) => {
      if (link.dataset.factsLink === id) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
  };

  const currentSection = () => {
    const marker = offset() + 8;
    let current = sections[0];
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= marker) current = section;
      else break;
    }
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 3;
    return atBottom ? sections[sections.length - 1] : current;
  };

  const sync = () => {
    ticking = false;
    if (!sections.length) return;
    if (targetId) {
      const target = document.getElementById(targetId);
      if (target) {
        setActive(targetId);
        if (Math.abs(target.getBoundingClientRect().top - offset()) > 3) return;
      }
      targetId = null;
    }
    setActive(currentSection()?.id);
  };

  const schedule = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(sync);
  };

  links.forEach((link) => {
    link.addEventListener('click', (event) => {
      const id = link.dataset.factsLink;
      const target = id ? document.getElementById(id) : null;
      if (!target) return;
      event.preventDefault();
      targetId = id;
      setActive(id);
      const top = Math.max(0, target.getBoundingClientRect().top + window.scrollY - offset());
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top, behavior: reduceMotion ? 'auto' : 'smooth' });
      history.replaceState(null, '', `#${id}`);
    });
  });

  const release = () => {
    targetId = null;
    schedule();
  };

  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule, { passive: true });
  window.addEventListener('wheel', release, { passive: true });
  window.addEventListener('touchstart', release, { passive: true });

  requestAnimationFrame(() => {
    if (location.hash) {
      const id = location.hash.slice(1);
      const target = document.getElementById(id);
      if (target && links.some((link) => link.dataset.factsLink === id)) {
        window.scrollTo({ top: Math.max(0, target.getBoundingClientRect().top + window.scrollY - offset()), behavior: 'auto' });
      }
    }
    sync();
  });
</script>
