---
const pathname = Astro.url.pathname;
const isFrench = pathname === '/fr' || pathname.startsWith('/fr/');

const homeHref = isFrench ? '/fr/' : '/';
const sportsHref = isFrench ? '/fr/sports/' : '/sports/';
const nutritionHref = isFrench ? '/fr/nutrition/' : '/nutrition/';
const openHref = isFrench ? '/fr/open/' : '/open/';
const contactHref = isFrench ? '/fr/#contact' : '/#contact';

const englishPath = isFrench ? (pathname.replace(/^\/fr(?=\/|$)/, '') || '/') : pathname;
const frenchPath = isFrench ? pathname : (pathname === '/' ? '/fr/' : `/fr${pathname}`);
---

<header class="m221-header">
  <div class="m221-container m221-header-inner">
    <a class="m221-brand" href={homeHref} aria-label={isFrench ? 'Accueil M221Tech' : 'M221Tech home'}>
      M221Tech
    </a>

    <nav class="m221-nav" aria-label={isFrench ? 'Navigation principale' : 'Main navigation'}>
      <a href={sportsHref} aria-current={pathname.includes('/sports') ? 'page' : undefined}>Sports</a>
      <a href={nutritionHref} aria-current={pathname.includes('/nutrition') ? 'page' : undefined}>Nutrition</a>
      <a href={openHref} aria-current={pathname.includes('/open') ? 'page' : undefined}>Open</a>
      <a href={contactHref}>{isFrench ? 'Contact' : 'Contact'}</a>
    </nav>

    <div class="m221-lang" aria-label={isFrench ? 'Choix de la langue' : 'Language selector'}>
      <a href={englishPath} aria-current={!isFrench ? 'true' : undefined}>EN</a>
      <span aria-hidden="true">/</span>
      <a href={frenchPath} aria-current={isFrench ? 'true' : undefined}>FR</a>
    </div>

    <details class="m221-mobile-nav">
      <summary>{isFrench ? 'Menu' : 'Menu'}</summary>
      <div class="m221-mobile-panel">
        <a href={sportsHref}>Sports</a>
        <a href={nutritionHref}>Nutrition</a>
        <a href={openHref}>Open</a>
        <a href={contactHref}>Contact</a>
        <div class="m221-lang">
          <a href={englishPath} aria-current={!isFrench ? 'true' : undefined}>EN</a>
          <span aria-hidden="true">/</span>
          <a href={frenchPath} aria-current={isFrench ? 'true' : undefined}>FR</a>
        </div>
      </div>
    </details>
  </div>
</header>
