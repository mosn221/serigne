---
// -----------------------------------------------------------------------------
// Shared site header.
//
// The component does not know project route names. Pages declare their high-level
// section through activeSection, which keeps this component extensible when new
// projects are added. englishPath/frenchPath are resolved by Layout.astro.
// -----------------------------------------------------------------------------
interface Props {
  activeSection?: 'projects' | 'open';
  englishPath: string;
  frenchPath: string;
  hasAlternate?: boolean;
}

const pathname = Astro.url.pathname;
const isFrench = pathname === '/fr' || pathname.startsWith('/fr/');
const {
  activeSection,
  englishPath,
  frenchPath,
  hasAlternate = true
} = Astro.props;

// All primary links intentionally return to sections of the brand homepage. Product
// pages therefore share one stable information architecture instead of duplicating it.
const homeHref = isFrench ? '/fr/' : '/';
const projectsHref = `${homeHref}#projects`;
const whyHref = `${homeHref}#why`;
const openHref = `${homeHref}#open`;
const contactHref = `${homeHref}#contact`;

const projectPage = activeSection === 'projects';
const openPage = activeSection === 'open';
const menuOpenLabel = isFrench ? 'Ouvrir le menu' : 'Open menu';
const menuCloseLabel = isFrench ? 'Fermer le menu' : 'Close menu';
const mobilePanelId = 'm221-mobile-navigation';

const labels = isFrench
  ? { projects: 'Projets', why: 'Pourquoi', open: 'Open', contact: 'Contact' }
  : { projects: 'Projects', why: 'Why', open: 'Open', contact: 'Contact' };
---

<!-- Desktop and mobile use the same semantic header. The <picture> swaps only the
     approved brand lockup according to available width. -->
<header class="m221-header">
  <div class="m221-container m221-header-inner">
    <a class="m221-brand" href={homeHref} aria-label={isFrench ? 'Accueil M221Tech' : 'M221Tech home'}>
      <picture class="m221-brand-picture">
        <source
          media="(max-width: 760px)"
          srcset="/assets/img/m221-site-lockup.svg"
          width="87"
          height="32"
        />
        <img
          src="/assets/img/m221tech-wordmark.svg"
          alt=""
          width="342"
          height="64"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    </a>

    <nav class="m221-nav" aria-label={isFrench ? 'Navigation principale' : 'Main navigation'}>
      <a href={projectsHref} data-active={projectPage ? 'true' : undefined}>{labels.projects}</a>
      <a href={whyHref}>{labels.why}</a>
      <a href={openHref} data-active={openPage ? 'true' : undefined}>{labels.open}</a>
      <a href={contactHref}>{labels.contact}</a>
    </nav>

    {hasAlternate && (
      <div class="m221-lang" aria-label={isFrench ? 'Choix de la langue' : 'Language selector'}>
        <a href={englishPath} lang="en" hreflang="en" data-lang-link="en" aria-current={!isFrench ? 'true' : undefined}>EN</a>
        <span aria-hidden="true">/</span>
        <a href={frenchPath} lang="fr" hreflang="fr" data-lang-link="fr" aria-current={isFrench ? 'true' : undefined}>FR</a>
      </div>
    )>

    <details class="m221-mobile-nav" data-mobile-menu>
      <summary
        aria-label={menuOpenLabel}
        aria-controls={mobilePanelId}
        aria-expanded="false"
        data-open-label={menuOpenLabel}
        data-close-label={menuCloseLabel}
      >
        <span class="m221-burger" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </summary>
      <div id={mobilePanelId} class="m221-mobile-panel">
        <a href={projectsHref} data-active={projectPage ? 'true' : undefined}>{labels.projects}</a>
        <a href={whyHref}>{labels.why}</a>
        <a href={openHref} data-active={openPage ? 'true' : undefined}>{labels.open}</a>
        <a href={contactHref}>{labels.contact}</a>
      </div>
    </details>
  </div>
</header>

<script>
  // Keep the header visually quiet at the top of the page and slightly more compact
  // once content scrolls underneath it. The listener is passive to avoid blocking scroll.
  const siteHeader = document.querySelector('.m221-header');
  const syncHeaderScroll = () => {
    if (!(siteHeader instanceof HTMLElement)) return;
    siteHeader.classList.toggle('is-scrolled', window.scrollY > 18);
  };

  syncHeaderScroll();
  window.addEventListener('scroll', syncHeaderScroll, { passive: true });

  // <details> gives us a native disclosure fallback. This controller synchronizes the
  // accessible label/state and closes the menu on selection, Escape or outside click.
  const menus = document.querySelectorAll('[data-mobile-menu]');

  menus.forEach((menu) => {
    if (!(menu instanceof HTMLDetailsElement)) return;
    const summary = menu.querySelector('summary');

    const syncMenuState = () => {
      if (!(summary instanceof HTMLElement)) return;
      const label = menu.open ? summary.dataset.closeLabel : summary.dataset.openLabel;
      if (label) summary.setAttribute('aria-label', label);
      summary.setAttribute('aria-expanded', String(menu.open));
    };

    menu.addEventListener('toggle', syncMenuState);
    syncMenuState();

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.open = false;
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.open) return;
      menu.open = false;
      if (summary instanceof HTMLElement) summary.focus();
    });

    document.addEventListener('pointerdown', (event) => {
      if (!menu.open || menu.contains(event.target)) return;
      menu.open = false;
    });

  });

  // Language changes try to preserve the user's reading position. We first preserve a
  // matching section id when available; otherwise we retain the relative scroll ratio.
  // sessionStorage is intentionally short-lived and cleared immediately on arrival.
  const languageLinks = document.querySelectorAll('[data-lang-link]');
  const positionKey = 'm221-language-position';

  // Local page navigations expose aria-current=true. Reading that state here avoids
  // hard-coding project-specific section names into the language switcher.
  const activeSectionId = () => {
    const activeLink = document.querySelector(
      '[data-section-link][aria-current="true"], [data-sports-link][aria-current="true"], [data-nutrition-link][aria-current="true"], [data-facts-link][aria-current="true"], [data-open-link][aria-current="true"]'
    );

    if (activeLink instanceof HTMLAnchorElement && activeLink.hash) {
      return activeLink.hash.slice(1);
    }

    if (window.location.hash) {
      const id = window.location.hash.slice(1);
      if (document.getElementById(id)) return id;
    }

    return '';
  };

  languageLinks.forEach((link) => {
    if (!(link instanceof HTMLAnchorElement)) return;

    link.addEventListener('click', (event) => {
      const target = new URL(link.href, window.location.origin);

      if (target.pathname === window.location.pathname) return;

      const sectionId = activeSectionId();
      const section = sectionId ? document.getElementById(sectionId) : null;
      const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      const ratio = window.scrollY / maxScroll;

      const state = {
        targetPath: target.pathname,
        sectionId,
        sectionDelta: section ? window.scrollY - section.offsetTop : null,
        ratio
      };

      try {
        sessionStorage.setItem(positionKey, JSON.stringify(state));
      } catch {}

      if (sectionId) target.hash = sectionId;
      else if (window.location.hash) target.hash = window.location.hash;

      event.preventDefault();
      window.location.href = target.toString();
    });
  });

  // Restore position only when the stored state targets the page that actually loaded;
  // stale state can therefore never move an unrelated page.
  window.addEventListener('load', () => {
    let state = null;

    try {
      const raw = sessionStorage.getItem(positionKey);
      if (raw) state = JSON.parse(raw);
      sessionStorage.removeItem(positionKey);
    } catch {
      state = null;
    }

    if (!state || state.targetPath !== window.location.pathname) return;

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        const section = state.sectionId ? document.getElementById(state.sectionId) : null;

        if (section && Number.isFinite(state.sectionDelta)) {
          window.scrollTo({
            top: Math.max(0, section.offsetTop + state.sectionDelta),
            behavior: 'auto'
          });
          return;
        }

        if (Number.isFinite(state.ratio)) {
          const maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
          window.scrollTo({ top: maxScroll * state.ratio, behavior: 'auto' });
        }
      });
    });
  });
</script>