---
const pathname = Astro.url.pathname;
const isFrench = pathname === '/fr' || pathname.startsWith('/fr/');

const copy = isFrench
  ? {
      eyebrow: 'À PROPOS / M221TECH',
      title: 'Indépendante, concrète, construite de près.',
      body: "M221Tech est une data house indépendante avec une idée simple : une donnée utile doit finir dans un produit que l’on peut réellement explorer. M221Foot, Lekkantu et Galsen Facts donnent aujourd’hui trois formes à cette idée ; l’approche reste la même — structurer proprement, construire simplement, publier ce qui sert.",
      signature: 'DATA × PRODUIT × INGÉNIERIE',
      alt: 'Avatar M221Tech'
    }
  : {
      eyebrow: 'ABOUT / M221TECH',
      title: 'Independent, hands-on by design.',
      body: 'M221Tech is an independent data house built around one simple idea: useful data should end up in products people can actually explore. M221Foot, Lekkantu and Galsen Facts are three current expressions of that idea; the approach stays the same — structure carefully, build simply, ship what is useful.',
      signature: 'DATA × PRODUCT × ENGINEERING',
      alt: 'M221Tech avatar'
    };

const avatarSrc = '/assets/img/m221tech-about-avatar.webp';
---

<section class="m221-about" aria-labelledby="m221-about-title">
  <div class="m221-container m221-about-inner">
    <figure class="m221-about-avatar" aria-hidden="true">
      <img
        src={avatarSrc}
        alt=""
        width="384"
        height="384"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="m221-about-copy">
      <span class="m221-about-eyebrow">{copy.eyebrow}</span>
      <h2 id="m221-about-title">{copy.title}</h2>
      <p>{copy.body}</p>
      <span class="m221-about-signature">{copy.signature}</span>
    </div>
  </div>
</section>

<style>
  .m221-about{
    position:relative;
    border-top:1px solid rgba(255,255,255,.07);
    border-bottom:1px solid rgba(255,255,255,.07);
    background:#0A0F1C;
  }

  .m221-about-inner{
    min-height:280px;
    display:grid;
    grid-template-columns:170px minmax(0,1fr);
    gap:42px;
    align-items:center;
    padding-top:42px;
    padding-bottom:42px;
  }

  .m221-about-avatar{
    width:150px;
    height:150px;
    margin:0;
    overflow:visible;
    border:0;
    border-radius:0;
    background:transparent;
    transform:none;
  }

  .m221-about-avatar img{
    width:100%;
    height:100%;
    display:block;
    object-fit:cover;
    mix-blend-mode:lighten;
    filter:drop-shadow(0 14px 28px rgba(0,0,0,.16));
  }

  .m221-about-copy{
    max-width:790px;
  }

  .m221-about-eyebrow,
  .m221-about-signature{
    font-family:'IBM Plex Mono',ui-monospace,SFMono-Regular,Menlo,monospace;
    text-transform:uppercase;
    letter-spacing:.08em;
  }

  .m221-about-eyebrow{
    display:block;
    margin-bottom:12px;
    color:#7EE8F7;
    font-size:.62rem;
    font-weight:600;
  }

  .m221-about-copy h2{
    max-width:760px;
    margin:0;
    font:600 clamp(2rem,4vw,3.6rem)/.98 'Space Grotesk',sans-serif;
    letter-spacing:-.05em;
    text-wrap:balance;
  }

  .m221-about-copy p{
    max-width:740px;
    margin:18px 0 0;
    color:#8D99AA;
    font-size:.92rem;
    line-height:1.65;
  }

  .m221-about-signature{
    display:inline-block;
    margin-top:20px;
    color:#59677C;
    font-size:.55rem;
  }

  @media(max-width:760px){
    .m221-about-inner{
      min-height:0;
      grid-template-columns:92px minmax(0,1fr);
      gap:18px;
      align-items:start;
      padding-top:34px;
      padding-bottom:34px;
    }

    .m221-about-avatar{
      width:86px;
      height:86px;
      border-radius:18px;
    }

    .m221-about-copy h2{
      font-size:clamp(1.65rem,7.5vw,2.35rem);
    }

    .m221-about-copy p{
      margin-top:12px;
      font-size:.8rem;
      line-height:1.55;
    }

    .m221-about-signature{
      margin-top:14px;
      font-size:.5rem;
    }
  }

  @media(max-width:430px){
    .m221-about-inner{
      grid-template-columns:1fr;
      gap:16px;
    }

    .m221-about-avatar{
      width:76px;
      height:76px;
      border-radius:16px;
    }
  }

  @media(prefers-reduced-motion:reduce){
    .m221-about-avatar{transform:none}
  }
</style>
