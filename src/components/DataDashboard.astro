---
// DataDashboard.astro
// -----------------------------------------------------------------------
// Composant "vitrine" : au lieu de simplement ÉCRIRE que M221Tech sait
// faire de la data visualisation, ce composant le PROUVE en affichant un
// vrai graphique interactif, alimenté par un vrai fichier de données.
//
// Fonctionnement en deux temps :
//   1. Ici (frontmatter Astro, entre les "---"), on lit le JSON au moment
//      du BUILD (sur le serveur, une seule fois). Aucun JS n'est encore
//      envoyé au visiteur à ce stade.
//   2. Plus bas (balise <script>), le JS s'exécute dans le NAVIGATEUR du
//      visiteur pour dessiner le graphique avec Chart.js. C'est le seul
//      endroit du site qui charge du JS "lourd" — et il ne se charge que
//      sur cette section précise, pas sur tout le site.
// -----------------------------------------------------------------------

import dashboardData from '../data/dashboard-demo.json';
const { categories } = dashboardData;
---

<section class="section reveal" id="dashboard-demo">
  <div class="container">
    <h2 class="section-title">La data en action, pas juste en texte</h2>
    <p class="section-intro">
      Un aperçu réel de la manière dont nous structurons et visualisons des données locales —
      ici un extrait du projet Lekkantu, notre base de données nutritionnelle.
    </p>

    <div class="hero-card" style="padding: 1.5rem;">
      <!-- Le <canvas> est l'élément HTML où Chart.js va dessiner le
           graphique. Il est vide au départ : le script ci-dessous le
           remplit dynamiquement une fois chargé dans le navigateur. -->
      <canvas
        id="lekkantu-demo-chart"
        role="img"
        aria-label="Répartition des produits alimentaires documentés par catégorie"
        height="120"
      ></canvas>

      <p style="margin-top:1rem; color: var(--muted); font-size: 0.85rem;">
        Données de démonstration — à connecter au dataset public Lekkantu.
      </p>
    </div>
  </div>
</section>

<script define:vars={{ categories }}>
  // "define:vars" est une particularité d'Astro : ça permet de passer une
  // variable calculée côté build (ici "categories", venant du JSON) à ce
  // script qui s'exécute côté navigateur. Sans ça, le script n'aurait
  // aucun moyen d'accéder aux données lues plus haut.

  // import() dynamique = Chart.js n'est téléchargé par le navigateur QUE
  // lorsque cette ligne s'exécute, donc seulement sur les pages qui
  // affichent ce composant. Le reste du site n'est jamais alourdi par
  // cette librairie.
  import('chart.js/auto').then(({ default: Chart }) => {
    const canvas = document.getElementById('lekkantu-demo-chart');
    if (!canvas) return; // sécurité si jamais le canvas n'existe pas

    new Chart(canvas, {
      type: 'bar',
      data: {
        // On transforme le tableau JSON en deux tableaux séparés :
        // les libellés (axe X) et les valeurs (hauteur des barres).
        labels: categories.map((c) => c.label),
        datasets: [
          {
            label: 'Produits documentés',
            data: categories.map((c) => c.count),
            backgroundColor: 'rgba(29, 233, 255, 0.55)', // cyan semi-transparent
            borderColor: '#1DE9FF',
            borderWidth: 1,
            borderRadius: 8 // coins arrondis, cohérent avec le design du site
          }
        ]
      },
      options: {
        responsive: true, // le graphique s'adapte à la largeur de son conteneur
        plugins: {
          legend: { display: false } // une seule série de données → légende inutile
        },
        scales: {
          // Couleurs des axes et de la grille, choisies pour rester
          // lisibles sur le fond sombre du site (var(--muted), var(--border))
          x: { ticks: { color: '#AEB6C2' }, grid: { color: 'rgba(255,255,255,0.06)' } },
          y: { ticks: { color: '#AEB6C2' }, grid: { color: 'rgba(255,255,255,0.06)' } }
        }
      }
    });
  });
</script>
