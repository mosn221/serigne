---
interface Props {
  size?: number;
  variant?: 'color' | 'mono-light' | 'mono-dark';
  className?: string;
  decorative?: boolean;
  alt?: string;
}

const {
  size = 72,
  variant = 'color',
  className = '',
  decorative = true,
  alt = 'Editorial project mark'
} = Astro.props;

const src = variant === 'mono-light'
  ? '/assets/galsen-facts/mark-mono-light.svg'
  : variant === 'mono-dark'
    ? '/assets/galsen-facts/mark-mono-dark.svg'
    : '/assets/galsen-facts/mark.svg';
---

<img
  class={className}
  src={src}
  width={size}
  height={size}
  alt={decorative ? '' : alt}
  aria-hidden={decorative ? 'true' : undefined}
  loading="eager"
  decoding="async"
/>
