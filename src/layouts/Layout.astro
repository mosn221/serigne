---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import '../styles/global.css';
import '../styles/legacy.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const {
  title,
  description,
  ogImage = 'https://m221.tech/assets/img/logo_carre_transp.png'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Netlify exposes CONTEXT during the build. Only the production context
// should be indexable; branch deploys and deploy previews stay out of search.
const isProduction = process.env.CONTEXT === 'production';
const robotsContent = isProduction ? 'index,follow' : 'noindex,nofollow';
---

<!DOCTYPE html>
<html lang="fr" class="no-js">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robotsContent} />
  <meta name="googlebot" content={robotsContent} />

  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" href={canonicalURL} hreflang="fr" />
  <link rel="alternate" href={canonicalURL} hreflang="x-default" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:url" content={canonicalURL} />

  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "M221Tech",
    "url": "https://m221.tech",
    "logo": "https://m221.tech/assets/img/logo_carre_transp.png",
    "description": "M221Tech conçoit et développe des plateformes de données, des applications web et des outils numériques pour des projets data-driven.",
    "sameAs": [
      "https://www.linkedin.com/company/m221tech",
      "https://github.com/m221tech",
      "https://www.kaggle.com/m221tech"
    ]
  })} />

  <link rel="icon" type="image/png" href="/assets/img/icone_favicon_512.png" />
  <link rel="apple-touch-icon" href="/assets/img/icone_favicon_512.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Montserrat:wght@500;600;700&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <div class="scroll-progress" id="scrollProgress"></div>

  <Header />

  <div id="menu-overlay" class="menu-overlay"></div>

  <main>
    <slot />
  </main>

  <Footer />

  <button id="scrollTopBtn" class="back-to-top" aria-label="Retour en haut" type="button">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path
        d="M12 19V7M6 13l6-6 6 6"
        stroke="white"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        fill="none"
      />
    </svg>
  </button>

  <script>
    import '../scripts/site.js';
  </script>
</body>
</html>
