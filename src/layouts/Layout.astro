---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import '../styles/global.css';
import '../styles/refactor.css';
import '../styles/brand.css';
import '../styles/home-v4-skeleton.css';
import '../styles/responsive.css';
import '../styles/mobile-spine.css';
import '../styles/footer-v2.css';
import '../styles/global-polish.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const {
  title,
  description,
  ogImage = 'https://m221.tech/assets/img/logo_carre_transp.png'
} = Astro.props;
const pathname = Astro.url.pathname;
const isFrench = pathname === '/fr' || pathname.startsWith('/fr/');
const lang = isFrench ? 'fr' : 'en';

const canonicalURL = new URL(pathname, Astro.site);
const englishPath = isFrench ? (pathname.replace(/^\/fr(?=\/|$)/, '') || '/') : pathname;
const frenchPath = isFrench ? pathname : (pathname === '/' ? '/fr/' : `/fr${pathname}`);
const englishURL = new URL(englishPath, Astro.site);
const frenchURL = new URL(frenchPath, Astro.site);

const isProduction = process.env.CONTEXT === 'production';
const robotsContent = isProduction ? 'index,follow' : 'noindex,nofollow';

const organizationDescription = isFrench
  ? 'M221Tech est une data house qui construit des produits numériques, des datasets et des projets autour de la donnée.'
  : 'M221Tech is a data house building digital products, datasets and projects around data.';
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0B1020" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robotsContent} />
  <meta name="googlebot" content={robotsContent} />

  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" href={englishURL} hreflang="en" />
  <link rel="alternate" href={frenchURL} hreflang="fr" />
  <link rel="alternate" href={englishURL} hreflang="x-default" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="M221Tech" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:locale" content={isFrench ? 'fr_FR' : 'en_US'} />
  <meta property="og:image" content={ogImage} />

  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImage} />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'M221Tech',
    url: 'https://m221.tech',
    logo: 'https://m221.tech/assets/img/logo_carre_transp.png',
    description: organizationDescription,
    sameAs: [
      'https://www.linkedin.com/company/m221tech',
      'https://www.kaggle.com/m221tech'
    ]
  })} />

  <link rel="icon" type="image/png" href="/assets/img/icone_favicon_512.png" />
  <link rel="apple-touch-icon" href="/assets/img/icone_favicon_512.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>
