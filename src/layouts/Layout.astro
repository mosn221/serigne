---
// -----------------------------------------------------------------------------
// Global document shell for every public M221Tech page.
//
// Responsibilities kept here on purpose:
// - load the shared CSS layers in a deterministic order;
// - normalize public URLs and trailing slashes;
// - expose canonical / hreflang / Open Graph / Twitter metadata;
// - emit Organization + WebSite + WebPage structured data;
// - keep deploy previews out of search indexes;
// - pass navigation/language state to the shared header.
//
// Page-specific content, styling and interaction should stay in the page itself.
// -----------------------------------------------------------------------------
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import '../styles/global.css';
import '../styles/refactor.css';
import '../styles/brand.css';
import '../styles/responsive.css';
import '../styles/chrome.css';

// Public page contract. New project pages should normally only need title,
// description and navSection. alternatePath=null explicitly marks a page as
// single-language so we never emit a language link to a route that does not exist.
interface Props {
  title: string;
  description: string;
  ogImage?: string;
  navSection?: 'projects' | 'open';
  alternatePath?: string | null;
}

const {
  title,
  description,
  ogImage = '/assets/img/m221tech-social-card.png',
  navSection,
  alternatePath
} = Astro.props;

// Normalize every route to the site's canonical trailing-slash convention before
// building SEO URLs. This keeps canonical, hreflang and navigation paths aligned.
const rawPathname = Astro.url.pathname;
const normalizePath = (path: string) => path === '/' ? '/' : `${path.replace(/\/+$/, '')}/`;
const pathname = normalizePath(rawPathname);
const isFrench = pathname === '/fr/' || pathname.startsWith('/fr/');
const lang = isFrench ? 'fr' : 'en';

// Language pairing defaults to the mirrored /fr/... structure. alternatePath can
// override that pairing, while null disables alternates entirely for one-language pages.
const canonicalURL = new URL(pathname, Astro.site);
const inferredEnglishPath = isFrench ? normalizePath(pathname.replace(/^\/fr(?=\/|$)/, '') || '/') : pathname;
const inferredFrenchPath = isFrench ? pathname : (pathname === '/' ? '/fr/' : normalizePath(`/fr${pathname}`));
const hasAlternate = alternatePath !== null;
const englishPath = isFrench && alternatePath ? normalizePath(alternatePath) : inferredEnglishPath;
const frenchPath = !isFrench && alternatePath ? normalizePath(alternatePath) : inferredFrenchPath;
const englishURL = new URL(englishPath, Astro.site);
const frenchURL = new URL(frenchPath, Astro.site);
const xDefaultURL = isFrench && !hasAlternate ? canonicalURL : englishURL;
const socialImageURL = new URL(ogImage, Astro.site);

// Netlify exposes CONTEXT=production only for the production deploy. Every preview
// therefore receives noindex automatically and cannot compete with m221.tech.
const isProduction = process.env.CONTEXT === 'production';
const robotsContent = isProduction
  ? 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'
  : 'noindex,nofollow,noarchive';
const socialImageAlt = isFrench
  ? 'M221Tech — identité visuelle'
  : 'M221Tech — visual identity';

// Keep the organization description deliberately broad: individual project pages
// can be specific, but M221Tech itself must remain able to host future verticals.
const organizationDescription = isFrench
  ? 'M221Tech conçoit des produits numériques, des jeux de données et des outils utiles à partir d’informations structurées.'
  : 'M221Tech designs digital products, datasets and useful tools from structured information.';

const organizationId = new URL('/#organization', Astro.site).href;
const websiteId = new URL('/#website', Astro.site).href;
const webpageId = `${canonicalURL.href}#webpage`;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0B1020" />
  <meta name="color-scheme" content="dark" />
  <meta name="application-name" content="M221Tech" />
  <meta name="apple-mobile-web-app-title" content="M221Tech" />

    <!-- Core search metadata -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robotsContent} />
  <meta name="googlebot" content={robotsContent} />

  <link rel="canonical" href={canonicalURL} />
  {(!isFrench || hasAlternate) && <link rel="alternate" href={englishURL} hreflang="en" />}
  {(isFrench || hasAlternate) && <link rel="alternate" href={frenchURL} hreflang="fr" />}
  <link rel="alternate" href={xDefaultURL} hreflang="x-default" />

  <!-- Social sharing metadata. The default card is the canonical M221Tech brand card;
       pages may override it with the ogImage prop when a product-specific card exists. -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="M221Tech" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:locale" content={isFrench ? 'fr_FR' : 'en_US'} />
  {hasAlternate && <meta property="og:locale:alternate" content={isFrench ? 'en_US' : 'fr_FR'} />}
  <meta property="og:image" content={socialImageURL} />
  <meta property="og:image:secure_url" content={socialImageURL} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={socialImageAlt} />

  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={socialImageURL} />
  <meta name="twitter:image:alt" content={socialImageAlt} />

  <!-- Structured data is centralized here so every page emits the same organization
       identity and only the WebPage node changes with the current route. -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Organization',
        '@id': organizationId,
        name: 'M221Tech',
        url: 'https://m221.tech/',
        logo: {
          '@type': 'ImageObject',
          url: 'https://m221.tech/assets/img/m221tech-mark-512.png',
          width: 512,
          height: 512
        },
        description: organizationDescription,
        sameAs: [
          'https://www.linkedin.com/company/m221tech',
          'https://www.kaggle.com/m221tech'
        ]
      },
      {
        '@type': 'WebSite',
        '@id': websiteId,
        url: 'https://m221.tech/',
        name: 'M221Tech',
        inLanguage: ['en', 'fr'],
        publisher: { '@id': organizationId }
      },
      {
        '@type': 'WebPage',
        '@id': webpageId,
        url: canonicalURL.href,
        name: title,
        description,
        inLanguage: lang,
        isPartOf: { '@id': websiteId },
        about: { '@id': organizationId },
        primaryImageOfPage: {
          '@type': 'ImageObject',
          url: socialImageURL.href,
          width: 1200,
          height: 630
        }
      }
    ]
  })} />

  <!-- Brand/device assets: SVG first, then raster and platform fallbacks. -->
  <link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg?v=20260923" />
  <link rel="shortcut icon" href="/favicon.ico?v=20260923" />
  <link rel="icon" type="image/png" sizes="48x48" href="/assets/img/favicon-48x48.png?v=20260923" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32x32.png?v=20260923" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicon-16x16.png?v=20260923" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/apple-touch-icon.png?v=20260923" />
  <link rel="manifest" href="/site.webmanifest?v=20260923" />
  <link rel="mask-icon" href="/assets/img/safari-pinned-tab.svg" color="#00BFD6" />

  <!-- Fonts are intentionally limited to the two brand families used by the site. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <!-- Keyboard users can bypass all shared navigation and land on page content. -->
  <a class="m221-skip-link" href="#main-content">{isFrench ? 'Aller au contenu' : 'Skip to content'}</a>
  <Header activeSection={navSection} englishPath={englishPath} frenchPath={frenchPath} hasAlternate={hasAlternate} />
  <main id="main-content" tabindex="-1">
    <slot />
  </main>
  <Footer />
</body>
</html>
