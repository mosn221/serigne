---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Nutrition data & food products | M221Tech"
  description="Explore M221Tech nutrition projects, starting with Lekkantu and its growing database of food products, ingredients and nutrition facts."
>
  <section class="m221-page-hero">
    <div class="m221-container">
      <a class="m221-back" href="/">← M221Tech</a>
      <span class="m221-kicker">Nutrition</span>
      <h1>Food data that feels closer to real life.</h1>
      <p>We focus on products people actually find, buy and eat — starting in Senegal, with room to grow across Africa.</p>
    </div>
  </section>

  <section class="m221-section">
    <div class="m221-container">
      <div class="m221-section-head">
        <h2>What we're building</h2>
        <p class="m221-section-intro">One product for now, built patiently and meant to grow.</p>
      </div>

      <div class="m221-product-list">
        <article class="m221-product">
          <div class="m221-product-meta">Nutrition platform</div>
          <div>
            <h3>Lekkantu</h3>
            <p>A growing food and nutrition database built around ingredients, nutrition facts, brands, categories and products available in Senegal and across Africa.</p>
          </div>
          <a href="https://lekkantu.com" target="_blank" rel="noopener noreferrer">Visit Lekkantu →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="m221-contact">
    <div class="m221-container">
      <h2>Curious about nutrition data?</h2>
      <p>Need a dataset, a report, or want to explore something together? Say hello.</p>
      <div class="m221-actions">
        <a class="m221-btn m221-btn-primary" href="mailto:m221tech@gmail.com?subject=M221Tech%20nutrition%20data">Say hello</a>
      </div>
    </div>
  </section>
</Layout>
