---
// -----------------------------------------------------------------------------
// English Nutrition project page. nutrition-v2 provides the foundation; nutrition-v3 is the current product-specific refinement layer.
// -----------------------------------------------------------------------------
import Layout from '../../layouts/Layout.astro';
import LekkantuBrandMark from '../../components/lekkantu/LekkantuBrandMark.astro';
import '../../styles/nutrition-v2.css';
import '../../styles/nutrition-v3.css';
---

<Layout
  title="M221Tech Nutrition | Understand food products in Senegal"
  description="Explore Lekkantu and M221Tech Nutrition to understand food products, ingredients and nutrition facts through clear, useful product experiences."
  navSection="projects"
  ogImage="/assets/lekkantu/social-base.png"
>
  <div class="m221-nutrition-page">
    <section class="m221-nutrition-hero">
      <div class="m221-container m221-nutrition-hero-inner">
        <a class="m221-nutrition-breadcrumb" href="/#projects">← M221Tech / Projects</a>
        <span class="m221-nutrition-kicker">M221TECH / NUTRITION</span>
        <h1>Food data, made easier to read.</h1>
        <p class="m221-nutrition-lead">Products, ingredients and nutrition facts — structured so the label makes more sense before the pack goes back on the shelf.</p>
        <div class="m221-nutrition-actions">
          <a class="is-primary" href="https://lekkantu.com" target="_blank" rel="noopener noreferrer">Open Lekkantu ↗</a>
          <a class="is-secondary" href="#product">Explore Nutrition ↓</a>
        </div>
      </div>
    </section>

    <div class="m221-nutrition-local-wrap">
      <nav class="m221-container m221-nutrition-local-nav" aria-label="Nutrition navigation" data-nutrition-nav>
        <a href="#product" data-nutrition-link="product"><span>01</span>Lekkantu</a>
        <a href="#reading" data-nutrition-link="reading"><span>02</span>Reading</a>
        <a href="#data" data-nutrition-link="data"><span>03</span>Data</a>
        <a href="#contact" data-nutrition-link="contact"><span>04</span>Contact</a>
      </nav>
    </div>

    <section class="m221-nutrition-chapter" id="product" data-nutrition-section>
      <div class="m221-container">
        <header class="m221-nutrition-chapter-head">
          <div class="m221-nutrition-index">01 / LEKKANTU</div>
          <h2>One product, built product by product.</h2>
          <p>Lekkantu is the core of Nutrition: a growing food database that brings product information into one readable structure.</p>
        </header>

        <article class="m221-nutrition-core">
          <div class="m221-nutrition-core-copy">
            <LekkantuBrandMark size={86} className="m221-lekkantu-mark" />
            <span class="m221-nutrition-eyebrow">CORE PRODUCT / FOOD DATA</span>
            <h3>Lekkantu</h3>
            <p>A growing database built around food products, ingredients, nutrition facts, brands and categories — starting with products found in Senegal and designed to grow beyond one market.</p>
            <div class="m221-nutrition-product-tags" aria-label="Lekkantu data areas">
              <span>PRODUCTS</span><span>INGREDIENTS</span><span>NUTRITION</span><span>BRANDS</span><span>CATEGORIES</span>
            </div>
            <div class="m221-nutrition-core-actions">
              <a class="m221-nutrition-open" href="https://lekkantu.com" target="_blank" rel="noopener noreferrer">Enter Lekkantu ↗</a>
              <a class="m221-nutrition-domain" href="https://lekkantu.com" target="_blank" rel="noopener noreferrer">lekkantu.com</a>
            </div>
          </div>

          <div class="m221-nutrition-sheet" aria-label="Anatomy of a structured product record">
            <div class="m221-nutrition-sheet-head">
              <span>STRUCTURED PRODUCT RECORD</span>
              <strong>What comes together</strong>
            </div>
            <div class="m221-nutrition-sheet-row"><span>Product</span><strong>Name, brand and category</strong></div>
            <div class="m221-nutrition-sheet-row"><span>Ingredients</span><strong>What is actually listed on the pack</strong></div>
            <div class="m221-nutrition-sheet-row"><span>Nutrition</span><strong>Values shown on the nutrition label</strong></div>
            <div class="m221-nutrition-sheet-row"><span>Context</span><strong>A clearer view of the product as a whole</strong></div>
          </div>
        </article>
      </div>
    </section>

    <section class="m221-nutrition-chapter m221-nutrition-reading" id="reading" data-nutrition-section>
      <div class="m221-container">
        <header class="m221-nutrition-chapter-head">
          <div class="m221-nutrition-index">02 / READING</div>
          <h2>The label is the interface.</h2>
          <p>Nutrition data becomes useful when the information on a pack is easier to notice, connect and understand.</p>
        </header>

        <div class="m221-nutrition-reader">
          <aside class="m221-nutrition-reader-note">
            <span>READING LENS</span>
            <h3>Less verdict. More context.</h3>
            <p>The aim is not to reduce a product to one magic score. Start with what is written, structure it, then make the important details easier to see.</p>
          </aside>

          <div class="m221-nutrition-reading-list">
            <details class="m221-nutrition-reading-item" open>
              <summary><span>01</span><strong>Ingredients</strong></summary>
              <p>Order, composition and wording matter. A structured ingredient list makes the pack easier to inspect without pretending the label says more than it does.</p>
            </details>
            <details class="m221-nutrition-reading-item">
              <summary><span>02</span><strong>Nutrition facts</strong></summary>
              <p>Energy, sugars, salt, fat, protein and other declared values belong together, with units and serving context kept clear.</p>
            </details>
            <details class="m221-nutrition-reading-item">
              <summary><span>03</span><strong>Product context</strong></summary>
              <p>Brand, category, format and front-of-pack wording help place the nutrition table back inside the actual product people see and buy.</p>
            </details>
          </div>
        </div>
      </div>
    </section>

    <section class="m221-nutrition-chapter" id="data" data-nutrition-section>
      <div class="m221-container">
        <header class="m221-nutrition-chapter-head">
          <div class="m221-nutrition-index">03 / APPROACH</div>
          <h2>Collect. Structure. Make readable.</h2>
          <p>The product grows through patient data work: capture what is available, organize it consistently, then build useful ways to read it.</p>
        </header>

        <div class="m221-nutrition-data-grid">
          <article class="m221-nutrition-data-item">
            <span>01 / COLLECT</span>
            <h3>Start with the pack.</h3>
            <p>Product information is captured from what is actually available: names, labels, ingredients and declared nutrition data.</p>
          </article>
          <article class="m221-nutrition-data-item">
            <span>02 / STRUCTURE</span>
            <h3>Give every field a place.</h3>
            <p>Brands, categories, ingredients and nutrition values become consistent data rather than disconnected label fragments.</p>
          </article>
          <article class="m221-nutrition-data-item">
            <span>03 / USE</span>
            <h3>Turn records into reading.</h3>
            <p>Product pages, editorial explanations and future analysis can all build on the same structured base.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="m221-nutrition-contact" id="contact" data-nutrition-section>
      <div class="m221-container m221-nutrition-contact-inner">
        <div class="m221-nutrition-index">04 / CONTACT</div>
        <div>
          <h2>Food data, question or idea?</h2>
          <p>Tell us what you are trying to understand.</p>
        </div>
        <a href="mailto:m221tech@gmail.com?subject=M221Tech%20Nutrition">m221tech@gmail.com →</a>
      </div>
    </section>
  </div>

  <script>
    // Scrollspy/local-navigation controller: sticky offsets are read from the real
    // rendered header/nav heights so responsive geometry stays synchronized.
    const header = document.querySelector('.m221-header');
    const localWrap = document.querySelector('.m221-nutrition-local-wrap');
    const links = Array.from(document.querySelectorAll('[data-nutrition-link]'));
    const sections = links
      .map((link) => document.getElementById(link.dataset.nutritionLink || ''))
      .filter(Boolean);

    let activeId = '';
    let targetId = null;
    let ticking = false;

    const offset = () => (header?.offsetHeight || 0) + (localWrap?.offsetHeight || 0) + 1;

    const setActive = (id) => {
      if (!id || activeId === id) return;
      activeId = id;
      links.forEach((link) => {
        if (link.dataset.nutritionLink === id) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    const currentSection = () => {
      const marker = offset() + 8;
      let current = sections[0];
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= marker) current = section;
        else break;
      }
      const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 3;
      return atBottom ? sections[sections.length - 1] : current;
    };

    const sync = () => {
      ticking = false;
      if (!sections.length) return;
      if (targetId) {
        const target = document.getElementById(targetId);
        if (target) {
          setActive(targetId);
          if (Math.abs(target.getBoundingClientRect().top - offset()) > 3) return;
        }
        targetId = null;
      }
      setActive(currentSection()?.id);
    };

    const schedule = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(sync);
    };

    links.forEach((link) => {
      link.addEventListener('click', (event) => {
        const id = link.dataset.nutritionLink;
        const target = id ? document.getElementById(id) : null;
        if (!target) return;
        event.preventDefault();
        targetId = id;
        setActive(id);
        const top = Math.max(0, target.getBoundingClientRect().top + window.scrollY - offset());
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top, behavior: reduceMotion ? 'auto' : 'smooth' });
        history.replaceState(null, '', `#${id}`);
      });
    });

    const release = () => {
      targetId = null;
      schedule();
    };

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    window.addEventListener('wheel', release, { passive: true });
    window.addEventListener('touchstart', release, { passive: true });

    requestAnimationFrame(() => {
      if (location.hash) {
        const id = location.hash.slice(1);
        const target = document.getElementById(id);
        if (target && links.some((link) => link.dataset.nutritionLink === id)) {
          window.scrollTo({ top: Math.max(0, target.getBoundingClientRect().top + window.scrollY - offset()), behavior: 'auto' });
        }
      }
      sync();
    });
  </script>
</Layout>
