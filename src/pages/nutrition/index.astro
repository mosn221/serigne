---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Nutrition | M221Tech"
  description="Explore M221Tech nutrition products, starting with Lekkantu."
>
  <section class="m221-page-hero">
    <div class="m221-container">
      <a class="m221-back" href="/">← M221Tech</a>
      <span class="m221-kicker">Nutrition</span>
      <h1>Nutrition data should reflect what people actually buy.</h1>
      <p>M221Tech structures food and nutrition data around products that are genuinely available and consumed locally.</p>
    </div>
  </section>

  <section class="m221-section">
    <div class="m221-container">
      <div class="m221-section-head">
        <h2>Product</h2>
        <p class="m221-section-intro">Our nutrition vertical currently starts with Lekkantu.</p>
      </div>

      <div class="m221-product-list">
        <article class="m221-product">
          <div class="m221-product-meta">Nutrition platform</div>
          <div>
            <h3>Lekkantu</h3>
            <p>A food and nutrition data product focused on ingredients, nutrition facts, brands, categories and products available in Senegal and Africa.</p>
          </div>
          <a href="https://lekkantu.com" target="_blank" rel="noopener noreferrer">Visit Lekkantu →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="m221-contact">
    <div class="m221-container">
      <h2>Interested in nutrition data?</h2>
      <p>Get in touch for a collaboration, a specific dataset need or a report request.</p>
      <div class="m221-actions">
        <a class="m221-btn m221-btn-primary" href="mailto:m221tech@gmail.com?subject=M221Tech%20nutrition%20data">Contact M221Tech</a>
      </div>
    </div>
  </section>
</Layout>
