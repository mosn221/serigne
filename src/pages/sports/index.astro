---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Sports | M221Tech"
  description="Explore M221Tech sports products: M221Foot and the WC2026 experience."
>
  <section class="m221-page-hero">
    <div class="m221-container">
      <a class="m221-back" href="/">← M221Tech</a>
      <span class="m221-kicker">Sports</span>
      <h1>Sports data deserves better coverage.</h1>
      <p>From permanent local competitions to major global events, M221Tech builds sports products around structured, useful data.</p>
    </div>
  </section>

  <section class="m221-section">
    <div class="m221-container">
      <div class="m221-section-head">
        <h2>Products</h2>
        <p class="m221-section-intro">Two complementary experiences: one permanent football platform and one event-focused World Cup product.</p>
      </div>

      <div class="m221-product-list">
        <article class="m221-product">
          <div class="m221-product-meta">Permanent platform</div>
          <div>
            <h3>M221Foot</h3>
            <p>A long-term football data platform for competitions, clubs, matches and richer local football intelligence.</p>
          </div>
          <a href="https://sports.m221.tech" target="_blank" rel="noopener noreferrer">Visit M221Foot →</a>
        </article>

        <article class="m221-product">
          <div class="m221-product-meta">Event experience</div>
          <div>
            <h3>WC2026</h3>
            <p>A World Cup 2026 data experience built around the tournament, with a Senegalese and African perspective.</p>
          </div>
          <a href="https://wc2026.m221.tech" target="_blank" rel="noopener noreferrer">Visit WC2026 →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="m221-contact">
    <div class="m221-container">
      <h2>Interested in sports data?</h2>
      <p>Get in touch for a collaboration, a specific data need or a report request.</p>
      <div class="m221-actions">
        <a class="m221-btn m221-btn-primary" href="mailto:m221tech@gmail.com?subject=M221Tech%20sports%20data">Contact M221Tech</a>
      </div>
    </div>
  </section>
</Layout>
