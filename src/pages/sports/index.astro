---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Sports | M221Tech"
  description="Explore M221Tech sports products: M221Foot and the WC2026 experience."
>
  <section class="m221-page-hero">
    <div class="m221-container">
      <a class="m221-back" href="/">← M221Tech</a>
      <span class="m221-kicker">Sports</span>
      <h1>Football data, closer to the game.</h1>
      <p>We build simple data products for local competitions and big moments, without losing the context around the game.</p>
    </div>
  </section>

  <section class="m221-section">
    <div class="m221-container">
      <div class="m221-section-head">
        <h2>What we're building</h2>
        <p class="m221-section-intro">Two products, two rhythms: one built for the long run, one built around a tournament.</p>
      </div>

      <div class="m221-product-list">
        <article class="m221-product">
          <div class="m221-product-meta">Permanent platform</div>
          <div>
            <h3>M221Foot</h3>
            <p>Our long-term football platform. Competitions, clubs, matches and richer local context, all in one place.</p>
          </div>
          <a href="https://sports.m221.tech" target="_blank" rel="noopener noreferrer">Visit M221Foot →</a>
        </article>

        <article class="m221-product">
          <div class="m221-product-meta">Event experience</div>
          <div>
            <h3>WC2026</h3>
            <p>A focused World Cup 2026 experience with a Senegalese and African point of view.</p>
          </div>
          <a href="https://wc2026.m221.tech" target="_blank" rel="noopener noreferrer">Visit WC2026 →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="m221-contact">
    <div class="m221-container">
      <h2>Working on something around sports data?</h2>
      <p>Need a dataset, a report, or simply want to compare notes? Say hello.</p>
      <div class="m221-actions">
        <a class="m221-btn m221-btn-primary" href="mailto:m221tech@gmail.com?subject=M221Tech%20sports%20data">Say hello</a>
      </div>
    </div>
  </section>
</Layout>
