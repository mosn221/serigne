---
import Layout from '../../layouts/Layout.astro';
import AboutM221 from '../../components/AboutM221.astro';
import '../../styles/home-v4.css';
import '../../styles/home-v5.css';
---

<Layout
  title="M221Tech | Des données aux usages."
  description="M221Tech conçoit des produits numériques, des jeux de données et des outils utiles pour transformer l’information structurée en usages concrets."
>
  <div class="m221-home-v4">
    <section class="m221-v4-hero">
      <div class="m221-container m221-v4-hero-grid">
        <div class="m221-v5-hero-copy">
          <span class="m221-v4-kicker">M221TECH / DATA HOUSE</span>
          <h1>Des données, transformées en produits.</h1>
          <p class="m221-v4-lead">Sport, alimentation et ce qui façonne le Sénégal. Des produits pensés pour explorer et comprendre.</p>
          <div class="m221-v4-hero-actions">
            <a class="m221-btn m221-btn-primary" href="#projects">Voir les projets</a>
            <a class="m221-btn m221-btn-secondary" href="#open">Open data</a>
          </div>
        </div>

        <div class="m221-v5-signal" aria-hidden="true">
          <div class="m221-v5-signal-core">DATA<br />HOUSE</div>
          <span class="m221-v5-signal-node" data-node="sports">Sports</span>
          <span class="m221-v5-signal-node" data-node="nutrition">Nutrition</span>
          <span class="m221-v5-signal-node" data-node="facts">Galsen Facts</span>
        </div>
      </div>
    </section>

    <div class="m221-v4-spine-wrap">
      <nav class="m221-container m221-v4-spine" aria-label="Sections de la home M221Tech" data-home-spine>
        <a href="#projects" data-section-link="projects"><span>01</span><span>Projets</span></a>
        <a href="#why" data-section-link="why"><span>02</span><span>Pourquoi</span></a>
        <a href="#open" data-section-link="open"><span>03</span><span>Open</span></a>
        <a href="#contact" data-section-link="contact"><span>04</span><span>Contact</span></a>
      </nav>
    </div>

    <section class="m221-v4-chapter m221-v4-overview" id="projects" data-home-section>
      <div class="m221-container">
        <header class="m221-v4-chapter-head">
          <div class="m221-v4-index">01 / PROJETS</div>
          <h2>Trois portes d’entrée. Trois manières d’explorer.</h2>
          <p>Le football, l’alimentation et ce qui façonne le Sénégal, avec un produit pensé pour chaque sujet.</p>
        </header>

        <div class="m221-v5-project-grid">
          <article class="m221-v5-project" data-tone="sports">
            <div class="m221-v5-project-top">
              <span class="m221-v5-project-no">PÔLE / 01</span>
              <span class="m221-v5-project-status">Sports</span>
            </div>
            <div class="m221-v5-project-main">
              <span class="m221-v4-domain">FOOTBALL / PRODUITS DATA</span>
              <h3>Sports</h3>
              <p>Le pôle sport, ses produits et ses expérimentations — de la plateforme football aux formats événementiels.</p>
            </div>
            <div class="m221-v5-project-actions">
              <a class="m221-v5-project-page" href="/fr/sports/">Découvrir Sports →</a>
              <a class="m221-v5-project-direct" href="https://sports.m221.tech" target="_blank" rel="noopener noreferrer">sports.m221.tech ↗</a>
            </div>
          </article>

          <article class="m221-v5-project" data-tone="food">
            <div class="m221-v5-project-top">
              <span class="m221-v5-project-no">PÔLE / 02</span>
              <span class="m221-v5-project-status">Nutrition</span>
            </div>
            <div class="m221-v5-project-main">
              <span class="m221-v4-domain">ALIMENTATION / DONNÉES NUTRITIONNELLES</span>
              <h3>Nutrition</h3>
              <p>Produits, ingrédients et données nutritionnelles à partir de ce qu'on trouve réellement dans les rayons.</p>
            </div>
            <div class="m221-v5-project-actions">
              <a class="m221-v5-project-page" href="/fr/nutrition/">Découvrir Nutrition →</a>
              <a class="m221-v5-project-direct" href="https://lekkantu.com" target="_blank" rel="noopener noreferrer">lekkantu.com ↗</a>
            </div>
          </article>

          <article class="m221-v5-project" data-tone="facts">
            <div class="m221-v5-project-top">
              <span class="m221-v5-project-no">PROJET / 03</span>
              <span class="m221-v5-project-status">Galsen Facts</span>
            </div>
            <div class="m221-v5-project-main">
              <span class="m221-v4-domain">SÉNÉGAL / INFORMATION PUBLIQUE</span>
              <h3>Galsen Facts</h3>
              <p>Des explorations simples autour des projets, dépenses publiques, territoires et autres sujets qui façonnent le pays.</p>
            </div>
            <div class="m221-v5-project-actions">
              <a class="m221-v5-project-page" href="/fr/galsen-facts/">Explorer Galsen Facts →</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="m221-v4-chapter m221-v4-why" id="why" data-home-section>
      <div class="m221-container">
        <header class="m221-v4-chapter-head">
          <div class="m221-v4-index">02 / POURQUOI</div>
          <h2>La donnée a besoin de structure. Le produit la rend utile.</h2>
          <p>C'est là qu'on travaille.</p>
        </header>

        <div class="m221-v4-why-grid">
          <div class="m221-v4-why-item"><span class="m221-v4-domain">01 / CONTEXTE</span><strong>Garder le contexte.</strong><p>Partir de lieux, produits et compétitions réels.</p></div>
          <div class="m221-v4-why-item"><span class="m221-v4-domain">02 / STRUCTURE</span><strong>Rendre la donnée utilisable.</strong><p>Transformer l'information dispersée en quelque chose de navigable.</p></div>
          <div class="m221-v4-why-item"><span class="m221-v4-domain">03 / PRODUIT</span><strong>Construire pour l'usage.</strong><p>Des interfaces d'abord. L'action avant la présentation.</p></div>
        </div>
      </div>
    </section>

    <section class="m221-v4-chapter" id="open" data-home-section>
      <div class="m221-container">
        <header class="m221-v4-chapter-head">
          <div class="m221-v4-index">03 / OPEN</div>
          <h2>Les données sortent. L'analyse se demande.</h2>
          <p>Certains datasets sont partagés. Les méthodes restent internes.</p>
        </header>
        <div class="m221-v4-open-grid">
          <a class="m221-v4-open-card" data-kind="data" href="/fr/open/#datasets"><div><span class="m221-v4-domain">OPEN DATA</span><h3>Parcourir les datasets</h3><p>Des publications publiques sélectionnées.</p></div><span class="m221-v4-open-arrow">→</span></a>
          <a class="m221-v4-open-card" data-kind="report" href="mailto:m221tech@gmail.com?subject=Demande%20de%20rapport%20M221Tech"><div><span class="m221-v4-domain">RAPPORTS</span><h3>Demander une analyse</h3><p>Une réponse ciblée à une vraie question.</p></div><span class="m221-v4-open-arrow">→</span></a>
        </div>
      </div>
    </section>

    <AboutM221 />

    <section class="m221-v4-contact" id="contact" data-home-section>
      <div class="m221-container m221-v4-contact-inner">
        <div class="m221-v4-index">04 / CONTACT</div>
        <div><h2>Un dataset, une question ou une idée ?</h2><p>Écrivez-nous.</p></div>
        <a class="m221-btn m221-btn-primary" href="mailto:m221tech@gmail.com">m221tech@gmail.com →</a>
      </div>
    </section>
  </div>

  <script>
    const spine = document.querySelector('.m221-v4-spine-wrap');
    const header = document.querySelector('.m221-header');
    const spineLinks = Array.from(document.querySelectorAll('[data-section-link]'));
    const sections = spineLinks
      .map((link) => document.getElementById(link.dataset.sectionLink || ''))
      .filter(Boolean);

    let activeId = '';
    let navigationTarget = null;
    let ticking = false;

    const navOffset = () => (header?.offsetHeight || 0) + (spine?.offsetHeight || 0) + 1;

    const setActive = (id) => {
      if (!id || activeId === id) return;
      activeId = id;
      spineLinks.forEach((link) => {
        if (link.dataset.sectionLink === id) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    const getCurrentSection = () => {
      const marker = navOffset() + 8;
      let current = sections[0];
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= marker) current = section;
        else break;
      }
      const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 3;
      return atBottom ? sections[sections.length - 1] : current;
    };

    const syncActive = () => {
      ticking = false;
      if (!sections.length) return;

      if (navigationTarget) {
        const target = document.getElementById(navigationTarget);
        if (target) {
          setActive(navigationTarget);
          if (Math.abs(target.getBoundingClientRect().top - navOffset()) > 3) return;
        }
        navigationTarget = null;
      }

      setActive(getCurrentSection()?.id);
    };

    const scheduleSync = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(syncActive);
    };

    const releaseNavigationLock = () => {
      navigationTarget = null;
      scheduleSync();
    };

    spineLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        const id = link.dataset.sectionLink;
        const target = id ? document.getElementById(id) : null;
        if (!target) return;

        event.preventDefault();
        navigationTarget = id;
        setActive(id);

        const top = Math.max(0, target.getBoundingClientRect().top + window.scrollY - navOffset());
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top, behavior: reduceMotion ? 'auto' : 'smooth' });
        history.replaceState(null, '', `#${id}`);
      });
    });

    window.addEventListener('scroll', scheduleSync, { passive: true });
    window.addEventListener('resize', scheduleSync, { passive: true });
    window.addEventListener('touchstart', releaseNavigationLock, { passive: true });
    window.addEventListener('wheel', releaseNavigationLock, { passive: true });

    requestAnimationFrame(() => {
      if (location.hash) {
        const id = location.hash.slice(1);
        const target = document.getElementById(id);
        if (target && spineLinks.some((link) => link.dataset.sectionLink === id)) {
          window.scrollTo({ top: Math.max(0, target.getBoundingClientRect().top + window.scrollY - navOffset()), behavior: 'auto' });
        }
      }
      syncActive();
    });
  </script>
</Layout>
