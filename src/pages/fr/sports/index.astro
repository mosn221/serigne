---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/sports-v2.css';
---

<Layout
  title="M221Tech Sports | Produits autour du football sénégalais"
  description="Découvrez M221Foot et M221Tech Sports : compétitions sénégalaises, contexte des matchs, profils joueurs et expérience WC2026."
>
  <div class="m221-sports-page">
    <section class="m221-sports-hero">
      <div class="m221-container m221-sports-hero-inner">
        <a class="m221-sports-breadcrumb" href="/fr/#projects">← M221Tech / Projets</a>
        <span class="m221-sports-kicker">M221TECH / SPORTS</span>
        <h1>La donnée football, pensée autour du jeu.</h1>
        <p class="m221-sports-lead">Compétitions, clubs, matchs et couches de contexte plus riches — structurés dans des produits faits pour explorer, suivre et utiliser.</p>
        <div class="m221-sports-actions">
          <a class="is-primary" href="https://sports.m221.tech" target="_blank" rel="noopener noreferrer">Ouvrir M221Foot ↗</a>
          <a class="is-secondary" href="#platform">Découvrir le pôle ↓</a>
        </div>
      </div>
    </section>

    <div class="m221-sports-local-wrap">
      <nav class="m221-container m221-sports-local-nav" aria-label="Navigation Sports" data-sports-nav>
        <a href="#platform" data-sports-link="platform"><span>01</span>M221Foot</a>
        <a href="#tournament" data-sports-link="tournament"><span>02</span>WC2026</a>
        <a href="#data" data-sports-link="data"><span>03</span>Data</a>
        <a href="#contact" data-sports-link="contact"><span>04</span>Contact</a>
      </nav>
    </div>

    <section class="m221-sports-chapter" id="platform" data-sports-section>
      <div class="m221-container">
        <header class="m221-sports-chapter-head">
          <div class="m221-sports-index">01 / M221FOOT</div>
          <h2>Le cœur du pôle Sports.</h2>
          <p>Une plateforme pensée pour durer : la structure des compétitions, le détail des matchs et les vues qui permettent d'aller plus loin.</p>
        </header>

        <article class="m221-sports-core">
          <div class="m221-sports-core-copy">
            <span class="m221-sports-eyebrow">PRODUIT CŒUR / PLATEFORME FOOTBALL</span>
            <h3>M221Foot</h3>
            <p>Une plateforme football construite autour des compétitions, clubs, calendriers, résultats, événements de match et vues plus riches lorsque les données le permettent.</p>
            <div class="m221-sports-core-actions">
              <a class="m221-sports-open" href="https://sports.m221.tech" target="_blank" rel="noopener noreferrer">Entrer dans M221Foot ↗</a>
              <a class="m221-sports-domain" href="https://sports.m221.tech" target="_blank" rel="noopener noreferrer">sports.m221.tech</a>
            </div>
          </div>

          <div class="m221-sports-capabilities" aria-label="Explorer les couches de M221Foot">
            <details class="m221-sports-capability" open>
              <summary>Compétitions</summary>
              <p>Saisons, calendriers, résultats et classements donnent le cadre général.</p>
            </details>
            <details class="m221-sports-capability">
              <summary>Clubs</summary>
              <p>Un niveau de lecture par équipe pour remettre les matchs et la saison dans leur contexte.</p>
            </details>
            <details class="m221-sports-capability">
              <summary>Matchs</summary>
              <p>Scores, événements et informations de match lorsque les sources disponibles le permettent.</p>
            </details>
            <details class="m221-sports-capability">
              <summary>Intelligence</summary>
              <p>Des vues et comparaisons construites au-dessus de la donnée structurée, sans perdre le match en dessous.</p>
            </details>
          </div>
        </article>
      </div>
    </section>

    <section class="m221-sports-chapter m221-sports-tournament" id="tournament" data-sports-section>
      <div class="m221-container">
        <header class="m221-sports-chapter-head">
          <div class="m221-sports-index">02 / WC2026</div>
          <h2>Un format événementiel du même univers.</h2>
          <p>WC2026 reprend la logique Sports et la concentre sur un tournoi : plus court, plus direct et volontairement distinct de la plateforme permanente.</p>
        </header>

        <article class="m221-sports-event">
          <div class="m221-sports-event-meta">EXTENSION SPORTS<br />ÉDITION 2026</div>
          <div class="m221-sports-event-copy">
            <h3>WC2026</h3>
            <p>Une expérience Coupe du Monde ciblée, pensée comme une extension du pôle Sports. Son intégration future à M221Foot reste ouverte : la page présente aujourd'hui les deux accès sans figer l'architecture de demain.</p>
          </div>
          <div class="m221-sports-event-actions">
            <a class="is-open" href="https://wc2026.m221.tech" target="_blank" rel="noopener noreferrer">Ouvrir WC2026 ↗</a>
            <a class="is-domain" href="https://wc2026.m221.tech" target="_blank" rel="noopener noreferrer">wc2026.m221.tech</a>
          </div>
        </article>
      </div>
    </section>

    <section class="m221-sports-chapter" id="data" data-sports-section>
      <div class="m221-container">
        <header class="m221-sports-chapter-head">
          <div class="m221-sports-index">03 / APPROCHE</div>
          <h2>Structurer d'abord. Explorer ensuite.</h2>
          <p>Le produit part de la donnée disponible, l'organise, puis construit des vues qui rendent le football plus simple à parcourir et à comparer.</p>
        </header>

        <div class="m221-sports-data-grid">
          <article class="m221-sports-data-item">
            <span>01 / STRUCTURE</span>
            <h3>Poser le cadre.</h3>
            <p>Saisons, clubs, calendrier, résultats et classement créent une base cohérente.</p>
          </article>
          <article class="m221-sports-data-item">
            <span>02 / CONTEXTE</span>
            <h3>Ajouter ce que le match raconte.</h3>
            <p>Compositions, événements, buteurs, cartons et changements enrichissent la lecture lorsque la source le permet.</p>
          </article>
          <article class="m221-sports-data-item">
            <span>03 / USAGE</span>
            <h3>Rendre la donnée navigable.</h3>
            <p>Pages, filtres, comparaisons et signaux transforment la structure en expérience utile.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="m221-sports-contact" id="contact" data-sports-section>
      <div class="m221-container m221-sports-contact-inner">
        <div class="m221-sports-index">04 / CONTACT</div>
        <div>
          <h2>Une donnée sport, une question ou une idée ?</h2>
          <p>Dites-nous ce que vous regardez.</p>
        </div>
        <a href="mailto:m221tech@gmail.com?subject=M221Tech%20Sports">m221tech@gmail.com →</a>
      </div>
    </section>
  </div>

  <script>
    const header = document.querySelector('.m221-header');
    const localWrap = document.querySelector('.m221-sports-local-wrap');
    const links = Array.from(document.querySelectorAll('[data-sports-link]'));
    const sections = links
      .map((link) => document.getElementById(link.dataset.sportsLink || ''))
      .filter(Boolean);

    let activeId = '';
    let targetId = null;
    let ticking = false;

    const offset = () => (header?.offsetHeight || 0) + (localWrap?.offsetHeight || 0) + 1;

    const setActive = (id) => {
      if (!id || activeId === id) return;
      activeId = id;
      links.forEach((link) => {
        if (link.dataset.sportsLink === id) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    const currentSection = () => {
      const marker = offset() + 8;
      let current = sections[0];
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= marker) current = section;
        else break;
      }
      const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 3;
      return atBottom ? sections[sections.length - 1] : current;
    };

    const sync = () => {
      ticking = false;
      if (!sections.length) return;
      if (targetId) {
        const target = document.getElementById(targetId);
        if (target) {
          setActive(targetId);
          if (Math.abs(target.getBoundingClientRect().top - offset()) > 3) return;
        }
        targetId = null;
      }
      setActive(currentSection()?.id);
    };

    const schedule = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(sync);
    };

    links.forEach((link) => {
      link.addEventListener('click', (event) => {
        const id = link.dataset.sportsLink;
        const target = id ? document.getElementById(id) : null;
        if (!target) return;
        event.preventDefault();
        targetId = id;
        setActive(id);
        const top = Math.max(0, target.getBoundingClientRect().top + window.scrollY - offset());
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top, behavior: reduceMotion ? 'auto' : 'smooth' });
        history.replaceState(null, '', `#${id}`);
      });
    });

    const release = () => {
      targetId = null;
      schedule();
    };

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    window.addEventListener('wheel', release, { passive: true });
    window.addEventListener('touchstart', release, { passive: true });

    requestAnimationFrame(() => {
      if (location.hash) {
        const id = location.hash.slice(1);
        const target = document.getElementById(id);
        if (target && links.some((link) => link.dataset.sportsLink === id)) {
          window.scrollTo({ top: Math.max(0, target.getBoundingClientRect().top + window.scrollY - offset()), behavior: 'auto' });
        }
      }
      sync();
    });
  </script>
</Layout>
