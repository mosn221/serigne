---
import Layout from '../layouts/Layout.astro';
import AboutM221 from '../components/AboutM221.astro';
import '../styles/home-v4.css';
import '../styles/home-v5.css';
---

<Layout
  title="M221Tech | Data, shaped for use."
  description="M221Tech builds focused products around football, food and public information about Senegal, with selected datasets and analysis when useful."
>
  <div class="m221-home-v4">
    <section class="m221-v4-hero">
      <div class="m221-container m221-v4-hero-grid">
        <div class="m221-v5-hero-copy">
          <span class="m221-v4-kicker">M221TECH / DATA HOUSE</span>
          <h1>Data, built into products.</h1>
          <p class="m221-v4-lead">Football, food and the forces shaping Senegal. Built into products made to explore and understand.</p>
          <div class="m221-v4-hero-actions">
            <a class="m221-btn m221-btn-primary" href="#projects">Explore projects</a>
            <a class="m221-btn m221-btn-secondary" href="#open">Open data</a>
          </div>
        </div>

        <div class="m221-v5-signal" aria-hidden="true">
          <div class="m221-v5-signal-core">DATA<br />HOUSE</div>
          <span class="m221-v5-signal-node" data-node="sports">Sports</span>
          <span class="m221-v5-signal-node" data-node="nutrition">Nutrition</span>
          <span class="m221-v5-signal-node" data-node="facts">Galsen Facts</span>
        </div>
      </div>
    </section>

    <div class="m221-v4-spine-wrap">
      <nav class="m221-container m221-v4-spine" aria-label="M221Tech home sections" data-home-spine>
        <a href="#projects" data-section-link="projects"><span>01</span><span>Projects</span></a>
        <a href="#why" data-section-link="why"><span>02</span><span>Why</span></a>
        <a href="#lab" data-section-link="lab"><span>03</span><span>Lab</span></a>
        <a href="#open" data-section-link="open"><span>04</span><span>Open</span></a>
        <a href="#contact" data-section-link="contact"><span>05</span><span>Contact</span></a>
      </nav>
    </div>

    <section class="m221-v4-chapter m221-v4-overview" id="projects" data-home-section>
      <div class="m221-container">
        <header class="m221-v4-chapter-head">
          <div class="m221-v4-index">01 / PROJECTS</div>
          <h2>Three ways in. Each one goes deeper.</h2>
          <p>Football, food and the forces shaping Senegal — each approached with a product built for the subject.</p>
        </header>

        <div class="m221-v5-project-grid">
          <article class="m221-v5-project" data-tone="sports">
            <div class="m221-v5-project-top">
              <span class="m221-v5-project-no">FIELD / 01</span>
              <span class="m221-v5-project-status">Sports</span>
            </div>
            <div class="m221-v5-project-main">
              <span class="m221-v4-domain">FOOTBALL / DATA PRODUCTS</span>
              <h3>Sports</h3>
              <p>The sports field, its products and experiments — including the football platform and tournament work.</p>
            </div>
            <div class="m221-v5-project-actions">
              <a class="m221-v5-project-page" href="/sports/">Explore Sports →</a>
              <a class="m221-v5-project-direct" href="https://sports.m221.tech" target="_blank" rel="noopener noreferrer">sports.m221.tech ↗</a>
            </div>
          </article>

          <article class="m221-v5-project" data-tone="food">
            <div class="m221-v5-project-top">
              <span class="m221-v5-project-no">FIELD / 02</span>
              <span class="m221-v5-project-status">Nutrition</span>
            </div>
            <div class="m221-v5-project-main">
              <span class="m221-v4-domain">FOOD / NUTRITION DATA</span>
              <h3>Nutrition</h3>
              <p>Food products, ingredients and nutrition data built around what people actually find, buy and eat.</p>
            </div>
            <div class="m221-v5-project-actions">
              <a class="m221-v5-project-page" href="/nutrition/">Explore Nutrition →</a>
              <a class="m221-v5-project-direct" href="https://lekkantu.com" target="_blank" rel="noopener noreferrer">lekkantu.com ↗</a>
            </div>
          </article>

          <article class="m221-v5-project" data-tone="facts">
            <div class="m221-v5-project-top">
              <span class="m221-v5-project-no">PROJECT / 03</span>
              <span class="m221-v5-project-status">Galsen Facts</span>
            </div>
            <div class="m221-v5-project-main">
              <span class="m221-v4-domain">SENEGAL / PUBLIC INFORMATION</span>
              <h3>Galsen Facts</h3>
              <p>Clear explorations of projects, public spending, places and other forces shaping Senegal.</p>
            </div>
            <div class="m221-v5-project-actions">
              <a class="m221-v5-project-page" href="/galsen-facts/">Explore Galsen Facts →</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="m221-v4-chapter m221-v4-why" id="why" data-home-section>
      <div class="m221-container">
        <header class="m221-v4-chapter-head">
          <div class="m221-v4-index">02 / WHY</div>
          <h2>Data needs structure. Product makes it useful.</h2>
          <p>That is the work.</p>
        </header>

        <div class="m221-v4-why-grid">
          <div class="m221-v4-why-item"><span class="m221-v4-domain">01 / CONTEXT</span><strong>Keep the context.</strong><p>Start from real places, products and competitions.</p></div>
          <div class="m221-v4-why-item"><span class="m221-v4-domain">02 / STRUCTURE</span><strong>Make data usable.</strong><p>Turn scattered information into something navigable.</p></div>
          <div class="m221-v4-why-item"><span class="m221-v4-domain">03 / PRODUCT</span><strong>Build for use.</strong><p>Interfaces first. Action over presentation.</p></div>
        </div>
      </div>
    </section>

    <section class="m221-v4-chapter" id="lab" data-home-section>
      <div class="m221-container">
        <header class="m221-v4-chapter-head">
          <div class="m221-v4-index">03 / LAB</div>
          <h2>Ideas worth testing.</h2>
          <p>Small experiments, kept useful.</p>
        </header>
        <article class="m221-v4-lab-card">
          <div class="m221-v4-index">LAB / 01</div>
          <div><h3>Kurel Facts</h3><p>Culture and knowledge, explored through data.</p></div>
          <a href="https://kurel.m221.tech" target="_blank" rel="noopener noreferrer">Open Kurel Facts ↗</a>
        </article>
      </div>
    </section>

    <section class="m221-v4-chapter" id="open" data-home-section>
      <div class="m221-container">
        <header class="m221-v4-chapter-head">
          <div class="m221-v4-index">04 / OPEN</div>
          <h2>Data out. Analysis on request.</h2>
          <p>Selected datasets are shared. Methods stay in-house.</p>
        </header>
        <div class="m221-v4-open-grid">
          <a class="m221-v4-open-card" data-kind="data" href="/open/#datasets"><div><span class="m221-v4-domain">OPEN DATA</span><h3>Browse datasets</h3><p>Selected public releases.</p></div><span class="m221-v4-open-arrow">→</span></a>
          <a class="m221-v4-open-card" data-kind="report" href="mailto:m221tech@gmail.com?subject=M221Tech%20report%20request"><div><span class="m221-v4-domain">REPORTS</span><h3>Request an analysis</h3><p>A focused answer to a real question.</p></div><span class="m221-v4-open-arrow">→</span></a>
        </div>
      </div>
    </section>

    <AboutM221 />

    <section class="m221-v4-contact" id="contact" data-home-section>
      <div class="m221-container m221-v4-contact-inner">
        <div class="m221-v4-index">05 / CONTACT</div>
        <div><h2>Dataset, question or idea?</h2><p>Talk to us.</p></div>
        <a class="m221-btn m221-btn-primary" href="mailto:m221tech@gmail.com">m221tech@gmail.com →</a>
      </div>
    </section>
  </div>

  <script>
    const spine = document.querySelector('.m221-v4-spine-wrap');
    const header = document.querySelector('.m221-header');
    const spineLinks = Array.from(document.querySelectorAll('[data-section-link]'));
    const sections = spineLinks
      .map((link) => document.getElementById(link.dataset.sectionLink || ''))
      .filter(Boolean);

    let activeId = '';
    let navigationTarget = null;
    let ticking = false;

    const navOffset = () => (header?.offsetHeight || 0) + (spine?.offsetHeight || 0) + 1;

    const setActive = (id) => {
      if (!id || activeId === id) return;
      activeId = id;
      spineLinks.forEach((link) => {
        if (link.dataset.sectionLink === id) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    const getCurrentSection = () => {
      const marker = navOffset() + 8;
      let current = sections[0];
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= marker) current = section;
        else break;
      }
      const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 3;
      return atBottom ? sections[sections.length - 1] : current;
    };

    const syncActive = () => {
      ticking = false;
      if (!sections.length) return;

      if (navigationTarget) {
        const target = document.getElementById(navigationTarget);
        if (target) {
          setActive(navigationTarget);
          if (Math.abs(target.getBoundingClientRect().top - navOffset()) > 3) return;
        }
        navigationTarget = null;
      }

      setActive(getCurrentSection()?.id);
    };

    const scheduleSync = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(syncActive);
    };

    const releaseNavigationLock = () => {
      navigationTarget = null;
      scheduleSync();
    };

    spineLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        const id = link.dataset.sectionLink;
        const target = id ? document.getElementById(id) : null;
        if (!target) return;

        event.preventDefault();
        navigationTarget = id;
        setActive(id);

        const top = Math.max(0, target.getBoundingClientRect().top + window.scrollY - navOffset());
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top, behavior: reduceMotion ? 'auto' : 'smooth' });
        history.replaceState(null, '', `#${id}`);
      });
    });

    window.addEventListener('scroll', scheduleSync, { passive: true });
    window.addEventListener('resize', scheduleSync, { passive: true });
    window.addEventListener('touchstart', releaseNavigationLock, { passive: true });
    window.addEventListener('wheel', releaseNavigationLock, { passive: true });

    requestAnimationFrame(() => {
      if (location.hash) {
        const id = location.hash.slice(1);
        const target = document.getElementById(id);
        if (target && spineLinks.some((link) => link.dataset.sectionLink === id)) {
          window.scrollTo({ top: Math.max(0, target.getBoundingClientRect().top + window.scrollY - navOffset()), behavior: 'auto' });
        }
      }
      syncActive();
    });
  </script>
</Layout>
