---
import Layout from '../layouts/Layout.astro';
import '../styles/home-v4.css';
---

<Layout
  title="M221Tech | Local data, built into products"
  description="M221Tech builds focused data products across sports, nutrition, open data and local knowledge."
>
  <div class="m221-home-v4">
    <section class="m221-v4-hero">
      <div class="m221-container m221-v4-hero-grid">
        <div>
          <span class="m221-v4-kicker">M221TECH / DATA HOUSE</span>
          <h1>Local data, built into products.</h1>
          <p class="m221-v4-lead">Sports, nutrition, open data and a few experiments. Built to be used.</p>
          <div class="m221-v4-hero-actions">
            <a class="m221-btn m221-btn-primary" href="#projects">Explore projects</a>
            <a class="m221-btn m221-btn-secondary" href="#open">Open data</a>
          </div>
        </div>

        <aside class="m221-v4-console" aria-label="M221Tech index">
          <div class="m221-v4-console-top"><span>M221Tech / index</span><i aria-hidden="true"></i></div>
          <div class="m221-v4-console-list">
            <a class="m221-v4-console-row" data-tone="sports" href="#projects"><span><strong>Projects</strong><small>SPORTS · NUTRITION</small></span><span>↓</span></a>
            <a class="m221-v4-console-row" href="#why"><span><strong>Why</strong><small>LOCAL · STRUCTURE · PRODUCT</small></span><span>↓</span></a>
            <a class="m221-v4-console-row" href="#lab"><span><strong>Lab</strong><small>EXPERIMENTS · LOCAL KNOWLEDGE</small></span><span>↓</span></a>
            <a class="m221-v4-console-row" href="#open"><span><strong>Open</strong><small>DATASETS · REPORTS</small></span><span>↓</span></a>
          </div>
        </aside>
      </div>
    </section>

    <div class="m221-v4-spine-wrap">
      <nav class="m221-container m221-v4-spine" aria-label="M221Tech home sections" data-home-spine>
        <a href="#projects" data-section-link="projects"><span>01</span><span>Projects</span></a>
        <a href="#why" data-section-link="why"><span>02</span><span>Why</span></a>
        <a href="#lab" data-section-link="lab"><span>03</span><span>Lab</span></a>
        <a href="#open" data-section-link="open"><span>04</span><span>Open</span></a>
        <a href="#contact" data-section-link="contact"><span>05</span><span>Contact</span></a>
      </nav>
    </div>

    <section class="m221-v4-chapter m221-v4-overview" id="projects" data-home-section>
      <div class="m221-container">
        <header class="m221-v4-chapter-head">
          <div class="m221-v4-index">01 / PROJECTS<strong>What we build</strong></div>
          <h2>Three products. Clear jobs.</h2>
          <p>Open one and explore.</p>
        </header>

        <div class="m221-v4-build-grid">
          <a class="m221-v4-build-card" data-tone="sports" href="https://sports.m221.tech" target="_blank" rel="noopener noreferrer">
            <span class="m221-v4-domain">SPORTS / PLATFORM</span>
            <strong>M221Foot</strong>
            <p>sports.m221.tech</p>
            <span class="m221-v4-build-arrow">↗</span>
          </a>
          <a class="m221-v4-build-card" data-tone="sports" href="https://wc2026.m221.tech" target="_blank" rel="noopener noreferrer">
            <span class="m221-v4-domain">SPORTS / EVENT</span>
            <strong>WC2026</strong>
            <p>wc2026.m221.tech</p>
            <span class="m221-v4-build-arrow">↗</span>
          </a>
          <a class="m221-v4-build-card" data-tone="food" href="https://lekkantu.com" target="_blank" rel="noopener noreferrer">
            <span class="m221-v4-domain">NUTRITION / DATABASE</span>
            <strong>Lekkantu</strong>
            <p>lekkantu.com</p>
            <span class="m221-v4-build-arrow">↗</span>
          </a>
        </div>
      </div>
    </section>

    <section class="m221-v4-chapter m221-v4-why" id="why" data-home-section>
      <div class="m221-container">
        <header class="m221-v4-chapter-head">
          <div class="m221-v4-index">02 / WHY<strong>Why M221Tech</strong></div>
          <h2>Local data needs a product layer.</h2>
          <p>That is the work.</p>
        </header>

        <div class="m221-v4-why-grid">
          <div class="m221-v4-why-item"><span class="m221-v4-domain">01 / LOCAL</span><strong>Keep the context.</strong><p>Start from real places, products and competitions.</p></div>
          <div class="m221-v4-why-item"><span class="m221-v4-domain">02 / STRUCTURE</span><strong>Make data usable.</strong><p>Turn scattered information into something navigable.</p></div>
          <div class="m221-v4-why-item"><span class="m221-v4-domain">03 / PRODUCT</span><strong>Build for use.</strong><p>Interfaces first. Action over presentation.</p></div>
        </div>
      </div>
    </section>

    <section class="m221-v4-chapter" id="lab" data-home-section>
      <div class="m221-container">
        <header class="m221-v4-chapter-head">
          <div class="m221-v4-index">03 / LAB<strong>From the lab</strong></div>
          <h2>Ideas worth testing.</h2>
          <p>Small experiments, kept useful.</p>
        </header>
        <article class="m221-v4-lab-card">
          <div class="m221-v4-index">LAB / 01</div>
          <div><h3>Kurel Facts</h3><p>Culture and local knowledge, explored through data.</p></div>
          <a href="https://kurel.m221.tech" target="_blank" rel="noopener noreferrer">Open Kurel Facts ↗</a>
        </article>
      </div>
    </section>

    <section class="m221-v4-chapter" id="open" data-home-section>
      <div class="m221-container">
        <header class="m221-v4-chapter-head">
          <div class="m221-v4-index">04 / OPEN<strong>Open</strong></div>
          <h2>Data out. Analysis on request.</h2>
          <p>Selected datasets are shared. Methods stay in-house.</p>
        </header>
        <div class="m221-v4-open-grid">
          <a class="m221-v4-open-card" data-kind="data" href="/open/#data"><div><span class="m221-v4-domain">OPEN DATA</span><h3>Browse datasets</h3><p>Selected public releases.</p></div><span class="m221-v4-open-arrow">→</span></a>
          <a class="m221-v4-open-card" data-kind="report" href="mailto:m221tech@gmail.com?subject=M221Tech%20report%20request"><div><span class="m221-v4-domain">REPORTS</span><h3>Request an analysis</h3><p>A focused answer to a real question.</p></div><span class="m221-v4-open-arrow">→</span></a>
        </div>
      </div>
    </section>

    <section class="m221-v4-contact" id="contact" data-home-section>
      <div class="m221-container m221-v4-contact-inner">
        <div class="m221-v4-index">05 / CONTACT<strong>Contact</strong></div>
        <div><h2>Dataset, question or idea?</h2><p>Talk to us.</p></div>
        <a class="m221-btn m221-btn-primary" href="mailto:m221tech@gmail.com">m221tech@gmail.com →</a>
      </div>
    </section>
  </div>

  <script>
    const spineLinks = Array.from(document.querySelectorAll('[data-section-link]'));
    const sections = Array.from(document.querySelectorAll('[data-home-section]'));
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).sort((a,b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        spineLinks.forEach((link) => link.setAttribute('aria-current', link.dataset.sectionLink === visible.target.id ? 'true' : 'false'));
      }, { rootMargin: '-22% 0px -58% 0px', threshold: [0,.1,.25,.5] });
      sections.forEach((section) => observer.observe(section));
    }
  </script>
</Layout>
