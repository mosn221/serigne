---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Open data & reports | M221Tech"
  description="Explore M221Tech public datasets and request data-driven reports."
>
  <section class="m221-page-hero">
    <div class="m221-container">
      <a class="m221-back" href="/">← M221Tech</a>
      <span class="m221-kicker">Open</span>
      <h1>Share useful data beyond our own products.</h1>
      <p>M221Tech selectively publishes datasets for reuse and prepares focused reports on request.</p>
    </div>
  </section>

  <section class="m221-section" id="data">
    <div class="m221-container">
      <div class="m221-section-head">
        <h2>Open Data</h2>
        <p class="m221-section-intro">Selected datasets made public for exploration, research and reuse.</p>
      </div>

      <article class="m221-product">
        <div class="m221-product-meta">Public datasets</div>
        <div>
          <h3>M221Tech datasets</h3>
          <p>Public releases can cover sports, nutrition and other local-data themes as they become ready for publication.</p>
        </div>
        <a href="https://www.kaggle.com/m221tech" target="_blank" rel="noopener noreferrer">View on Kaggle →</a>
      </article>
    </div>
  </section>

  <section class="m221-section" id="reports">
    <div class="m221-container">
      <div class="m221-section-head">
        <h2>Reports</h2>
        <p class="m221-section-intro">Reports are not a public download library. They are prepared and shared on request around specific questions, datasets or themes.</p>
      </div>

      <article class="m221-lab">
        <span class="m221-pill">Available on request</span>
        <h3>Data-driven analysis</h3>
        <p>Need a focused analysis around football, nutrition or another dataset we cover? Tell us the question and context.</p>
        <a href="mailto:m221tech@gmail.com?subject=M221Tech%20report%20request">Request a report →</a>
      </article>
    </div>
  </section>
</Layout>
