---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Open data & reports | M221Tech"
  description="Explore selected M221Tech datasets and request focused reports built from the data we cover."
>
  <section class="m221-page-hero">
    <div class="m221-container">
      <a class="m221-back" href="/">← M221Tech</a>
      <span class="m221-kicker">Open</span>
      <h1>Useful data should sometimes travel.</h1>
      <p>We publish selected datasets when they're ready, and we prepare focused reports on request.</p>
    </div>
  </section>

  <section class="m221-section" id="data">
    <div class="m221-container">
      <div class="m221-section-head">
        <h2>Open Data</h2>
        <p class="m221-section-intro">Clean enough to reuse, documented enough to understand.</p>
      </div>

      <article class="m221-product">
        <div class="m221-product-meta">Public datasets</div>
        <div>
          <h3>M221Tech datasets</h3>
          <p>Sports, nutrition and other local-data themes, released when the data is solid enough to be genuinely useful.</p>
        </div>
        <a href="https://www.kaggle.com/m221tech" target="_blank" rel="noopener noreferrer">View on Kaggle →</a>
      </article>
    </div>
  </section>

  <section class="m221-section" id="reports">
    <div class="m221-container">
      <div class="m221-section-head">
        <h2>Reports</h2>
        <p class="m221-section-intro">Not a report shelf. A focused answer to a question, built from the data and context we know.</p>
      </div>

      <article class="m221-lab">
        <span class="m221-pill">Available on request</span>
        <h3>Have a question worth digging into?</h3>
        <p>Football, nutrition or another dataset we cover — send us the question and a bit of context, and we'll take it from there.</p>
        <a href="mailto:m221tech@gmail.com?subject=M221Tech%20report%20request">Request a report →</a>
      </article>
    </div>
  </section>
</Layout>
